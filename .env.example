# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434

# Model used to author CV content (offline batch).
# gemma2:9b fits entirely in 8 GB of VRAM -> 18.3 tok/s.
# gemma4:12b spills ~5 GB to CPU on the same card -> 7.3 tok/s, ~4x the wall
# time for the full batch. Switch only if you want richer prose and can wait.
GEN_MODEL=gemma2:9b
# Model used for chat answering, metadata extraction and query routing.
CHAT_MODEL=gemma2:9b
# Multilingual embedding model - this is what makes ES<->EN retrieval work.
EMBED_MODEL=bge-m3

# --- Retrieval ---
TOP_K=5
RRF_K=60

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Photo generation (free, no API key required) ---
PHOTO_ENABLED=true
POLLINATIONS_URL=https://image.pollinations.ai/prompt
